<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="warehouseDB" transaction-type="RESOURCE_LOCAL">
        <class>com.example.warehouse.model.User</class>
        <class>com.example.warehouse.model.Category</class>
        <class>com.example.warehouse.model.Supplier</class>
        <class>com.example.warehouse.model.Product</class>
        <class>com.example.warehouse.model.PurchaseOrder</class>
        <class>com.example.warehouse.model.PurchaseOrderItem</class>
        <class>com.example.warehouse.model.StockMovement</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./warehousedb;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
        </properties>
    </persistence-unit>
</persistence>
